# Copy to ops.env and fill values. Never commit real secrets.
PORT=8090
AMANIKAH_DB=/data/amanikah.sqlite
OPS_ADMIN_TOKEN=replace-with-long-random-token
SESSION_PEPPER=replace-with-64-hex-chars
OPERATOR_EMAIL=ops@your-domain.example
MAIL_FROM=Amanikah <noreply@amanikah.com>
# Prefer Resend for transactional email, or SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=1
PUBLIC_BASE_URL=https://amanikah.com
WAITLIST_MODE=1
MATCHMAKING_LIVE=0
SITE_ROOT=/srv/amanikah

# Family Assistant AI: disabled until provider credentials and user consent are in place.
AMANIKAH_AI_ENABLED=0
OPENAI_API_KEY=
AMANIKAH_AI_MODEL=
VOICE_PRIVATE_DIR=/data/private_voice
